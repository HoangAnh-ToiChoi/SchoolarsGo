# Mẫu cấu hình trỏ vào Supabase Cloud (cho script chạy tay như cleanDb.js).
# Copy thành .env.cloud rồi điền giá trị thật. File .env.cloud đã nằm trong .gitignore, KHÔNG commit.
# Lấy ở Supabase Dashboard → Project Settings → Database → Connection string (Session pooler hoặc Direct).

PG_HOST=db.<project-ref>.supabase.co
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=<mật-khẩu-database>
PG_SSL=true
