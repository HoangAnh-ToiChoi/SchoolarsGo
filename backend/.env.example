PORT=3001
NODE_ENV=development

# ─────────────────────────────────────────
# Supabase Cloud
# ─────────────────────────────────────────
# Lấy ở Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ─────────────────────────────────────────
# JWT (generate two distinct values with at least 32 characters each)
# ─────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SAME_SITE=lax
TRUST_PROXY=1
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://hoanganh-toichoi.github.io
# Add the exact Vercel deployment origin here, without a path.

# ─────────────────────────────────────────
# AI (Optional) — Gemini chỉ dùng đọc CV và điền chỗ trống khi kéo học bổng.
# Chat và gợi ý không gọi LLM (chờ dịch vụ RAG riêng).
# ─────────────────────────────────────────
GEMINI_API_KEY=

# ─────────────────────────────────────────
# Monitoring (Optional — sentry.io free tier)
# ─────────────────────────────────────────
SENTRY_DSN=

# ─────────────────────────────────────────
# Frontend URL (for CORS)
# ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────
# Supabase Cloud Database (direct pg connection)
# Backend + seed script dùng biến PG_* để kết nối trực tiếp PostgreSQL
# Lấy ở Dashboard → Project Settings → Database → Connection string (Session/Transaction pooler)
# ─────────────────────────────────────────
PG_HOST=<pooler-host>.pooler.supabase.com
PG_PORT=6543
PG_DATABASE=postgres
PG_USER=postgres.<project-ref>
PG_PASSWORD=<mật-khẩu-database>
PG_SSL=true

# ─────────────────────────────────────────
# Email (Forgot Password)
# Dùng Gmail App Password — tạo tại myaccount.google.com/apppasswords
# ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="ScholarsGo <your@gmail.com>"

# Kéo học bổng tự động (src/ingestion): tự dùng Gemini khi có GEMINI_API_KEY ở trên.
# Đặt false để chỉ dùng luật chữ, không tốn hạn mức.
INGESTION_USE_AI=true
# Model Gemini dùng khi kéo học bổng. gemini-flash-lite-latest: bản lite nhanh (~2s/lần), luôn trỏ tới bản mới nhất. Tránh gemini-flash-latest (nặng, hay treo) và các model 2.x (đã ngừng).
GEMINI_MODEL=gemini-flash-lite-latest
