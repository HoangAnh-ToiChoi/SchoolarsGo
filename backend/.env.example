PORT=3001
NODE_ENV=development

# ─────────────────────────────────────────
# Supabase Local (Docker)
# ─────────────────────────────────────────
# Dùng Supabase local trong Docker — chạy `docker-compose up -d`
# URL trỏ đến Kong gateway (port 8000)
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNjaG9sYXJzZ28iLCJyb2xlIjoiYW5vbiIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxOTU3MzQ1MjAwfQ.fake
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNjaG9sYXJzZ28iLCJyb2xlIjoic2VydmljZSIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxOTU3MzQ1MjAwfQ.fake

# ─────────────────────────────────────────
# JWT (generate two distinct values with at least 32 characters each)
# ─────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SAME_SITE=lax
TRUST_PROXY=1
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://hoanganh-toichoi.github.io
# Add the exact Vercel deployment origin here, without a path.

# ─────────────────────────────────────────
# AI (Optional)
# ─────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ZHIPU_API_KEY=

# ─────────────────────────────────────────
# Monitoring (Optional — sentry.io free tier)
# ─────────────────────────────────────────
SENTRY_DSN=

# ─────────────────────────────────────────
# Frontend URL (for CORS)
# ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────
# Docker Local Database (direct pg connection)
# Seed script dùng biến PG_* để kết nối trực tiếp PostgreSQL (bỏ qua Supabase gateway)
# Chạy: docker-compose up -d (khởi động postgres + pgadmin)
# ─────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=scholarsgo
PG_USER=postgres
PG_PASSWORD=scholarsgo_password

# ─────────────────────────────────────────
# Email (Forgot Password)
# Dùng Gmail App Password — tạo tại myaccount.google.com/apppasswords
# ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="ScholarsGo <your@gmail.com>"

# Kéo học bổng tự động (src/ingestion): tự dùng Gemini khi có GEMINI_API_KEY ở trên.
# Đặt false để chỉ dùng luật chữ, không tốn hạn mức.
INGESTION_USE_AI=true
# Model Gemini dùng khi kéo học bổng. gemini-flash-lite-latest: bản lite nhanh (~2s/lần), luôn trỏ tới bản mới nhất. Tránh gemini-flash-latest (nặng, hay treo) và các model 2.x (đã ngừng).
GEMINI_MODEL=gemini-flash-lite-latest
