# Vite proxies /api to the local backend at http://localhost:3001 during development.
# Keep /api as the base path in production; Vercel forwards it to BACKEND_URL.
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Monitoring (Optional — sentry.io free tier)
VITE_SENTRY_DSN=
